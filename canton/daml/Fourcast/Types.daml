-- | Shared types for Fourcast prediction market contracts on Canton.
--
--   v2: positions are settled atomically via CIP-56 allocations (escrowed
--   transfers executed in the same transaction that archives the position),
--   so the `Open/Settled/Expired` bookkeeping status is gone — contract
--   existence encodes the state.
module Fourcast.Types where

import DA.Time (RelTime, days)

-- | Which side of a binary prediction market a position backs.
data Side = Yes | No
  deriving (Eq, Ord, Show)

-- | UI label for the settlement instrument. The authoritative reference is the
--   CIP-56 `InstrumentId` carried on market/position contracts; this label is
--   kept for API/UI compatibility.
data SettlementAsset = CBTC | CETH
  deriving (Eq, Ord, Show)

-- | Outcome of a resolved market.
data Outcome = ResolvedYes | ResolvedNo | Voided
  deriving (Eq, Show)

-- | Convert a Side to Text for external serialization.
sideToText : Side -> Text
sideToText Yes = "YES"
sideToText No = "NO"

-- | Convert a SettlementAsset to Text.
assetToText : SettlementAsset -> Text
assetToText CBTC = "CBTC"
assetToText CETH = "CETH"

-- | Check if a side matches a resolved outcome.
sideMatches : Side -> Outcome -> Bool
sideMatches Yes ResolvedYes = True
sideMatches No  ResolvedNo  = True
sideMatches _   _           = False

-- | Grace period after a market's deadline during which positions must be
--   settled; after it lapses, `ExpirePosition` refunds both escrowed legs.
settlementGrace : RelTime
settlementGrace = days 365
