# TxLINE Credentials
# The miner reads from the same .env.agent file as other workers on the VPS.
# These vars are already configured there — listed here for local dev reference.
TXLINE_API_TOKEN=your_activated_api_token
TXLINE_GUEST_JWT=optional_cached_jwt
TXLINE_API_ORIGIN=https://txline.txodds.com

# Server
PORT=8402
HOST=0.0.0.0

# Telegraph Registration (set after registering on integrate.telegraphprotocol.com)
TELEGRAPH_MINER_ID=
TELEGRAPH_MINER_SECRET=

# Solana wallet for x402 payment receipts (base58 private key)
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: restrict to specific leagues (comma-separated TxLINE competition IDs)
# Default: all subscribed leagues
TXLINE_COMPETITION_IDS=
