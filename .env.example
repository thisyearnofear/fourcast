# ── Canton Network (private prediction markets — devnet) ─────────────
# All server-side; never exposed to the browser except the DAR package ID.
# Without these, /canton pages render the honest "Devnet unavailable" state.
CANTON_JSON_API_URL=https://your-participant.validators.example.com
CANTON_OIDC_TOKEN_URL=https://your-keycloak.example.com/realms/your-realm/protocol/openid-connect/token
CANTON_OIDC_CLIENT_ID=your_client_id
CANTON_OIDC_USERNAME=your_keycloak_username
CANTON_OIDC_PASSWORD=your_keycloak_password
CANTON_OIDC_AUDIENCE=your_audience
CANTON_OIDC_SCOPE=openid daml_ledger_api offline_access
CANTON_LEDGER_USER_ID=your_ledger_user_id
CANTON_OPERATOR_PARTY_ID=FourcastOperator::your_party_fingerprint
NEXT_PUBLIC_CANTON_DAR_PACKAGE_ID=your_dar_package_hash
# Optional demo parties (allocated on the participant) — enable the live
# two-party privacy proof and holder dashboard.
CANTON_ALICE_PARTY_ID=
CANTON_BOB_PARTY_ID=
CANTON_OBSERVER_PARTY_ID=

# ── Bright Data (OPTIONAL — deep web scrape enrichment) ───────────────
# Analysis works without these. Leave unset or set BRIGHT_DATA_ENABLED=false
# when credits are exhausted. When available: SERP + Scraping Browser + Unlocker.
#
# BRIGHT_DATA_ENABLED=false
#
# BRIGHT_DATA_API_KEY=your_api_key_here
# BRIGHT_DATA_SERP_ZONE=your_serp_zone_name
# BRIGHT_DATA_SBR_WS_ENDPOINT=wss://brd-customer-xxx-zone-yyy@brd.superproxy.io:9222
# BRIGHT_DATA_UNLOCKER_ZONE=your_unlocker_zone_name
# BRIGHT_DATA_PROXY_URL=
# BRIGHT_DATA_PROXY_SECRET=

# ── AI / LLM ──────────────────────────────────────────────────────────
VENICE_API_KEY=your_venice_api_key

# ── Prediction Markets ────────────────────────────────────────────────
POLYMARKET_PRIVATE_KEY=your_private_key

# ── Database ──────────────────────────────────────────────────────────
TURSO_CONNECTION_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# ── Redis (optional, for caching) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Other Services ────────────────────────────────────────────────────
NEYNAR_API_KEY=your_neynar_key
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
NEXT_PUBLIC_WEATHER_API_KEY=your_openweather_key

# ── Autopilot Scheduler (optional) ────────────────────────────────────
# Bearer token Vercel Cron sends to /api/cron/autopilot. Unset = cron always 401s.
CRON_SECRET=your_random_cron_secret
# Gates writes to /api/agent/schedule (x-admin-secret header). Unset = writes
# denied in production, allowed only in development.
ADMIN_SECRET=your_admin_secret

# ── Telegram (optional — bot + notification push + cron alerts) ───────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Bot username without @ — used to build t.me deep links for notification linking
TELEGRAM_BOT_USERNAME=your_bot_username
# Your own chat id — receives autopilot cron failure alerts
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# ── canton-2.0.0 (atomic settlement) ─────────────────────────────────────
# Reference CIP-56 registry TokenRules contract id (created by
# scripts/canton-v2-preflight.mjs step 2 after the v2 DAR is uploaded)
CANTON_REFERENCE_RULES_CID=
# Designated resolution attester for new markets (defaults to operator =
# devnet self-attestation; point at an independent oracle party for prod)
#CANTON_ATTESTER_PARTY_ID=
# Node-side holder party test ids (offer/accept + holder-settle demos)
