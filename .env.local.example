NEXT_PUBLIC_HOST="<your-production-url>"

# ============================================
# ⚠️ CRITICAL: DO NOT SET NODE_ENV IN THIS FILE
# ============================================
# Setting NODE_ENV manually breaks Next.js 16 builds with:
# "TypeError: Cannot read properties of null (reading 'useContext')"
# Next.js automatically sets NODE_ENV based on the command:
# - npm run dev → NODE_ENV=development
# - npm run build → NODE_ENV=production
# See: https://nextjs.org/docs/messages/non-standard-node-env
# ============================================
# Movement M1 Testnet Configuration (Bardock - Chain ID 250)
# ============================================
NEXT_PUBLIC_USE_MARKETPLACE_CONTRACT=true

# ============================================
# Polymarket Integration Environment Variables
# Copy these to .env.local and fill in your credentials

# REQUIRED: Private key for order signing on Polymarket
# WARNING: Never commit actual private keys to version control
# Export from Magic Link: https://reveal.magic.link/polymarket
# Or from MetaMask: Settings > Account > Export Private Key
POLYMARKET_PRIVATE_KEY=your_private_key_here

# OPTIONAL: Builder API credentials for gasless transactions (production)
# Only needed if using Builder Signing Server for remote signing
POLY_BUILDER_API_KEY=your_actual_api_key_here
POLY_BUILDER_SECRET=your_actual_secret_here
POLY_BUILDER_PASSPHRASE=your_actual_passphrase_here

# Polygon RPC for wallet status checks (used by /api/wallet)
# Default: https://polygon-rpc.com/ (public)
# For higher reliability, use an RPC provider like:
# - Infura: https://polygon-mainnet.infura.io/v3/{INFURA_KEY}
# - Alchemy: https://polygon-mainnet.g.alchemy.com/v2/{ALCHEMY_KEY}
NEXT_PUBLIC_BNB_RPC_URL=https://bsc-testnet.publicnode.com
NEXT_PUBLIC_BNB_CHAIN_ID=97

# Optional server signer for submitting predictions (BNB Testnet/Mainnet)
# Leave unset to require client signature via wallet
BNB_PRIVATE_KEY=

# PredictionReceipt contract address on BNBChain (required for on-chain logging)
PREDICTION_CONTRACT_ADDRESS=
PREDICTION_FEE_BPS=100

PREDICTION_CONTRACT_ADDRESS_ARBITRUM=
PREDICTION_FEE_BPS_ARBITRUM=500
ARB_RPC_URL=
ARB_PRIVATE_KEY=

PREDICTION_CONTRACT_ADDRESS_BNB=
PREDICTION_FEE_BPS_BNB=500

PREDICTION_CONTRACT_ADDRESS_POLYGON=
PREDICTION_FEE_BPS_POLYGON=100
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=

# Redis Configuration for AI Analysis Caching (Week 1 Enhancement)
# For local development: redis://localhost:6379
# For Upstash (recommended): Use Upstash Redis REST URL
# REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Venice AI API Key for Weather Analysis

# Get from: https://venice.ai/ 

VENICE_API_KEY=your_venice_api_key_here

REDIS_URL=redis://localhost:6379



# Farcaster Integration (Neynar API)

# Get from: https://neynar.com

NEYNAR_API_KEY=your_neynar_api_key_here

# ============================================
# Circle / Arc Subscription Integration
# ============================================

# Arc RPC URL — defaults to https://arc-node.thecanteenapp.com/
ARC_RPC_URL=https://arc-node.thecanteenapp.com/

# USDC token address on Arc testnet (Circle-deployed)
NEXT_PUBLIC_USDC_TOKEN=0x3600000000000000000000000000000000000000
USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000

# Deployed SubscriptionManager contract address (set after deployment)
NEXT_PUBLIC_SUBSCRIPTION_CONTRACT=0xC7e26e89f85Fc91FBE80cCd85B65FdD1d8016a22

# PredictionReceiptERC20 on Arc — signal publishing (deploy: node scripts/deploy-prediction-receipt.js)
# NEXT_PUBLIC_PREDICTION_RECEIPT_CONTRACT=
# PREDICTION_FEE_BPS_ARC=0
# NEXT_PUBLIC_ARC_RPC_URL=https://arc-node.thecanteenapp.com/

# Treasury address that receives subscription USDC payments
TREASURY_ADDRESS=0x55A5705453Ee82c742274154136Fce8149597058

# Deployer private key (for deploying SubscriptionManager contract)
# DEPLOYER_PRIVATE_KEY=

# Telegram Bot (for /edge commands via messaging)
# Create bot at https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=

# Photon Spectrum (for iMessage + WhatsApp multi-platform)
# Sign up at https://app.photon.codes
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=

# Featherless AI (for Telegram bot casual queries — preferred over Venice)
# Sign up at https://featherless.ai
# FEATHERLESS_API_KEY=

# Bot API secret (Telegram / external callers send header x-fourcast-auth).
# Same-origin Markets UI does NOT need this header — analyze allows browser
# same-origin requests when the secret is set. Unset = fully open analyze API.
# Generate with: node -e "console.log('bot_secret_' + require('crypto').randomBytes(16).toString('hex'))"
# BOT_API_SECRET=bot_secret_

# ============================================
# Canton Network — Private Settlement Layer
# ============================================
# Fourcast uses Canton for private prediction positions with cBTC/cETH.
# Position sizes are visible only to the operator and the holder.
#
# Feature flag: set to true to show Canton UI in the app.
NEXT_PUBLIC_CANTON_ENABLED=false

# The Daml DAR package ID (computed at `dpm build` time).
# Find it by inspecting the DAR: unzip -l canton/.daml/dist/canton-1.0.0.dar | head -1
# The hash is the 64-char hex string in the filename prefix.
# Current build (Daml SDK 3.5.2, compatible with DevNet 3.5.8):
# v2 (atomic settlement) — set by scripts/canton-v2-preflight.mjs after the v2 DAR is uploaded
NEXT_PUBLIC_CANTON_DAR_PACKAGE_ID=550828d219effd88bc03fadd856403ab42795e33c185cbea4ff2e055a2ed930a
# v1 (legacy, IOU bookkeeping): 1fdf1b33676d9025e48da98baece72818feee5e0efaf60b4788daa547560b784
CANTON_REFERENCE_RULES_CID=
#CANTON_ATTESTER_PARTY_ID=

# The Fourcast operator's Canton party ID.
# The operator is the signatory on PredictionPosition and PredictionMarket.
# Allocated on NODERS NaaS Devnet:
CANTON_OPERATOR_PARTY_ID=FourcastOperator::122003aa7c491e00a453145c4d2cd3dbf5db8908b4e663c9944baed57fd66effa668
NEXT_PUBLIC_CANTON_OPERATOR_PARTY_ID=FourcastOperator::122003aa7c491e00a453145c4d2cd3dbf5db8908b4e663c9944baed57fd66effa668

# Demo trader party IDs (for testing privacy model)
# These parties can hold positions but cannot see each other's positions.
# Allocate these on the NODERS participant node:
CANTON_ALICE_PARTY_ID=AliceHolder::...
CANTON_BOB_PARTY_ID=BobHolder::...

# Canton network to connect to.
NEXT_PUBLIC_CANTON_NETWORK=devnet

# --- Server-side direct ledger API (OIDC password grant) ---
# All Daml commands and contract queries go through our Next.js API routes,
# which authenticate to the NODERS Keycloak via password grant and call the
# Canton JSON Ledger API directly. No browser extension needed.
#
# These credentials are SERVER-ONLY (never prefixed with NEXT_PUBLIC_).
# Get them from your NaaS provider (NODERS) or your Keycloak admin.

# Canton JSON Ledger API URL (the participant node's HTTP endpoint):
CANTON_JSON_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services:443

# Keycloak OIDC token endpoint:
CANTON_OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token

# Keycloak client ID (must support password grant):
CANTON_OIDC_CLIENT_ID=web-app-ui-hackcanton-01-devnet

# Keycloak user credentials (email/username + password):
CANTON_OIDC_USERNAME=your_email@example.com
CANTON_OIDC_PASSWORD=xxx

# Token audience and scope:
CANTON_OIDC_AUDIENCE=https://hackcanton-01.devnet.naas.noders.services
CANTON_OIDC_SCOPE=openid daml_ledger_api offline_access

# Ledger user ID (Keycloak subject UUID — matches the token's "sub" claim):
CANTON_LEDGER_USER_ID=your-keycloak-subject-uuid

# ============================================
# TxLINE World Cup (primary sports data layer)
# ============================================
# The /world-cup route uses TxLINE as its primary source for fixtures,
# consensus odds, scores, and verifiable Merkle receipts on Solana.
#
# To get these credentials, run the onboarding scripts:
#   1. node scripts/txline-generate-wallet.mjs      # generates a Solana keypair
#   2. Fund the printed public address with devnet SOL (https://faucet.solana.com)
#   3. node scripts/txline-subscribe-and-activate.mjs  # on-chain subscribe + activate
#
# WARNING: TXLINE_SOLANA_SECRET_KEY is a signing key. NEVER commit it, NEVER
# set it on Vercel. The deployed app only needs TXLINE_API_TOKEN + TXLINE_GUEST_JWT.

# Activated API token (from POST /api/token/activate). Sent as X-Api-Token header.
TXLINE_API_TOKEN=your_activated_api_token_here

# Guest JWT (from POST /auth/guest/start, renewable without re-subscribing).
# Sent as Authorization: Bearer header. Auto-refreshed on 401.
TXLINE_GUEST_JWT=your_guest_jwt_here

# TxLINE API host (devnet or mainnet). Must match the network used for subscribe.
TXLINE_API_ORIGIN=https://txline-dev.txodds.com

# Solana network and program (must match TXLINE_API_ORIGIN).
TXLINE_SOLANA_NETWORK=devnet
TXLINE_PROGRAM_ID=6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J
TXLINE_SERVICE_LEVEL=1

# Adapter mode: 'live' (use TxLINE API), 'replay' (use cached snapshots), or 'auto' (default; live when API token present).
TXLINE_MODE=live

# The on-chain subscribe transaction signature (used to re-activate the JWT if needed).
TXLINE_LAST_TX_SIG=your_subscribe_tx_signature_here

# The wallet public address (non-sensitive; like an email address for the chain).
TXLINE_SOLANA_PUBLIC_KEY=your_solana_wallet_public_key_here

# The wallet SECRET KEY - LOCAL ONLY, NEVER COMMIT, NEVER SET ON VERCEL.
# Used only to (re-)activate the subscription; the deployed app does not need it.
TXLINE_SOLANA_SECRET_KEY=your_base58_secret_key_here

# World Cup competition ID (72 = FIFA World Cup). Numeric, optional.
# TXLINE_WC_COMPETITION_ID=72

# ============================================
# Delphi / Gensyn — Agent Trading Competition
# ============================================
# The Delphi Agent Arena is a time-boxed prediction market competition on
# Gensyn Testnet using LMSR markets. Winning shares pay exactly 1 token.
#
# Register wallet on DoraHacks: https://dorahacks.io/hackathon/delphi-agent-competition/detail
# Generate API key: https://delphi-api-access.gensyn.ai/
# Competition leaderboard: https://agent-competition.gensyn.ai

# Network: "testnet" | "mainnet" | "competition-testnet"
DELPHI_NETWORK=competition-testnet

# Signer type: "private_key" (recommended for agents)
DELPHI_SIGNER_TYPE=private_key

# The private key for your registered competition wallet (0x-prefixed hex).
# This wallet MUST be the same one registered on DoraHacks.
# Competition tokens are distributed automatically after registration.
# NOTE: the SDK reads WALLET_PRIVATE_KEY (no DELPHI_ prefix).
WALLET_PRIVATE_KEY=******************************************

# Testnet API key for read operations (market discovery, positions).
# Generate at: https://delphi-api-access.gensyn.ai/
DELPHI_API_ACCESS_KEY=your_testnet_api_key_here

# Collateral (TST) token address on competition-testnet. The published SDK
# ships this redacted; without it, balance/approval/trade calls fail.
# Resolve it on-chain: eth_call TOKEN() on the gateway
# (0x097599c9D966fF496284b892A8F13BF885b258ef, chain 685685) — see docs/DELPHI_AGENT.md.
DELPHI_TOKEN_ADDRESS=<tst_address_from_gateway_TOKEN_call>

# Optional: Pin to a specific competition UUID (omit to use active competition)
# DELPHI_COMPETITION_ID=

# Agent loop configuration
DELPHI_AGENT_INTERVAL_MS=300000
DELPHI_AGENT_MIN_EDGE=0.05
DELPHI_AGENT_MAX_ALLOCATION_PCT=0.10
DELPHI_AGENT_MAX_SHARES_PER_TRADE=5
DELPHI_AGENT_SLIPPAGE_PCT=2
DELPHI_AGENT_DRY_RUN=true

# ─── LLM Intelligence (Delphi agent forecaster) ─────────────────────────────
# The forecaster uses an OpenAI-compatible provider chain with failover.
# Chain order (comma-separated, only keyed providers are attempted):
# DELPHI_AGENT_LLM_PROVIDERS=vercel,bai,venice,nvidia,openrouter

# Vercel AI Gateway (primary) — https://vercel.com/docs/ai-gateway
# One gateway key → many providers/models. Free tier exposes a limited set
# (e.g. zai/glm-4.7-flash) and rate-limits bursts (429 recovers in ~minutes);
# GLM-5.2 and friends are paid-only on this tier.
VERCEL_GATEWAY_API_KEY=
VERCEL_GATEWAY_MODEL=zai/glm-4.7-flash

# OpenRouter — https://openrouter.ai/keys
# One key → many models. Tip: ":free" model variants cost nothing (rate-limited),
# good for testing while unfunded; ":online" variants add web search (for
# news-driven markets; not yet wired into prompts).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# NVIDIA NIM (fallback) — https://build.nvidia.com/ (free tier)
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Venice (final fallback) — https://venice.ai/settings/api
# NOTE: credits exhausted 2026-08-12 (402) — top up to re-enable.
VENICE_API_KEY=
# DELPHI_AGENT_VENICE_MODEL=llama-3.3-70b

# B.AI (free DeepSeek-V4-Flash, unlimited free access — limited-time offer)
# Get key at: https://b.ai
# Model: deepseek-v4-flash
# NOTE: set in shell env as BAI_API_KEY (not DELPHI_ prefix)
BAI_API_KEY=
# BAI_MODEL=deepseek-v4-flash

# Forecaster tuning
DELPHI_AGENT_MIN_EDGE=0.03
DELPHI_AGENT_MAX_MARKETS=25

# Go-live gating (paper-trade anything not listed):
# - DELPHI_AGENT_LIVE_SOURCES: intelligence source prefixes allowed to trade
#   for real.
#   Cost-constrained stance (no TxLINE subscription): allow the free
#   deterministic datafeed + free LLM providers + the free ESPN sports-odds
#   anchor (no key, no cost). Do NOT list `txline` — its main odds need a paid
#   subscription.
DELPHI_AGENT_LIVE_SOURCES=datafeed,openrouter,nvidia,venv,gateway,espn
# Empty = all categories trade live when their source is allow-listed:
# DELPHI_AGENT_LIVE_CATEGORIES=sports,crypto,politics,economics,miscellaneous

# Web search for LLM forecasts. When VERCEL_GATEWAY_API_KEY is set, evidence
# retrieval uses Vercel AI Gateway's built-in Exa search (free through
# Aug 31 2026 on the gateway free tier). If the gateway is unavailable or
# rate-limited, it falls back to a direct Exa API key if EXA_API_KEY is set.
# OpenRouter web plugin / Venice web params may also be used by the router,
# but OpenRouter web search requires paid credits; the router auto-degrades
# to no-web on 400/402 and retries 429s on :free models with backoff.
DELPHI_AGENT_WEB_SEARCH=true

# Direct Exa API fallback for web evidence retrieval.
# https://dashboard.exa.ai — ~$0.005/query, 6h per-question cache.
# Optional when VERCEL_GATEWAY_API_KEY is configured.
EXA_API_KEY=
